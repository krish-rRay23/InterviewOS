# InterviewOS Environment Configuration Template

# Server Port
PORT=8080

# Primary PostgreSQL Database
DATABASE_URL=postgres://postgres:interviewos_secure_password@localhost:5432/interviewos?sslmode=disable

# Redis Streams Event Distribution
REDIS_URL=redis://localhost:6379

# Temporal Workflow Orchestration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# LLM Provider Configuration (Optional - Offline deterministic engine runs by default)
LLM_PROVIDER=offline
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Speech Recognition & Multilingual TTS Providers (Optional)
ASR_PROVIDER=offline
WHISPER_API_KEY=
SARVAM_API_KEY=

# Endpoint Agent Settings
AGENT_JOURNAL_DIR=./evidence_journal
AGENT_HEARTBEAT_INTERVAL_SECONDS=5
AGENT_BATCH_WINDOW_SECONDS=3
