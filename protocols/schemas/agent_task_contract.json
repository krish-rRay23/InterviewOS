{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewos.dev/schemas/agent_task_contract.json",
  "title": "AgentTaskContract",
  "type": "object",
  "required": [
    "task_id",
    "session_id",
    "requesting_agent",
    "target_agent",
    "objective",
    "capability_token",
    "max_tool_calls",
    "deadline_utc",
    "evidence_references",
    "status"
  ],
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "parent_task_id": { "type": ["string", "null"] },
    "session_id": { "type": "string", "format": "uuid" },
    "requesting_agent": { "type": "string" },
    "target_agent": { "type": "string" },
    "objective": { "type": "string" },
    "capability_token": { "type": "string" },
    "max_tool_calls": { "type": "integer", "minimum": 1, "default": 5 },
    "deadline_utc": { "type": "string", "format": "date-time" },
    "evidence_references": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "IN_PROGRESS", "COMPLETED", "REJECTED_UNAUTHORIZED", "TIMED_OUT", "FAILED"]
    },
    "result_payload": { "type": ["object", "null"] },
    "created_at_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}